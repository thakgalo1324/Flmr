<?xml version="1.0" encoding="UTF-8"?>
<strategy name="Gold Beast Bands">
  <!-- Backtested on real XAUUSD M1 data, Jan 2026, 0.01 lot, ratchet on.
       Fades price when it closes outside the Bollinger Band (20, 2.5): buys under the lower band, sells above the upper band.
       Only when the market is moving (ATR above 3.5 dollars).
       Result at a $0.30 spread: 170 trades, ~69% wins, +$240, worst drawdown $60, biggest loss $16. At $0.50 spread: +$209. At $0.70: +$136.
       Few trades (about 6 a day), so give it time. Run on demo. -->
  <timeframe>M1</timeframe>
  <lots>0.01</lots>
  <stoploss atr="1.0" period="14"/>
  <takeprofit atr="0.3" period="14"/>
  <trail step="0.2"/>
  <rule side="long" action="enter">
    <cross a="close" b="bb:lower:20:2.5" dir="below"/>
    <compare a="atr:14" op="gt" b="3.5"/>
  </rule>
  <rule side="short" action="enter">
    <cross a="close" b="bb:upper:20:2.5" dir="above"/>
    <compare a="atr:14" op="gt" b="3.5"/>
  </rule>
</strategy>
